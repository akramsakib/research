# Copy these exports into your shell or paste them before running setup scripts.
# Do not commit real secrets.

# One-time or ephemeral Tailscale auth key. Only needed until this Arena node joins your tailnet.
export TAILSCALE_AUTHKEY='YOUR_TAILSCALE_AUTH_KEY'

# A label for this Arena node in your Tailscale admin console.
export TAILSCALE_HOSTNAME='arena-strix'

# Your Kali host in the tailnet.
export KALI_HOST='kali-hostname-or-100.x.y.z'
export KALI_USER='strix'
export KALI_PORT='22'

# Optional: where local folders are synced on Kali.
export KALI_REMOTE_ROOT='~/strix-arena-workspaces'
